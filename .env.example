# ==============================================================================
# TERA: Emergency Assistance & Response Coordination Platform - Environment Config
# ==============================================================================

# 1. Database Connection (PostgreSQL 15+ for Production / SQLite fallback for local test)
# PostgreSQL Production:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tera_db
# Local SQLite Dev:
# DATABASE_URL=sqlite:///./backend/tera.db

# 2. JWT Authentication & Security
SECRET_KEY=change_this_to_a_secure_cryptographic_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Application Metadata
PROJECT_NAME="TERA: Production-Grade Emergency Assistance & Response Coordination Platform"
VERSION="2.0.0"
API_V1_STR="/api"

# 4. Evidence Storage Configuration
EVIDENCE_UPLOAD_DIR="./backend/uploads"
MAX_EVIDENCE_SIZE_BYTES=15728640

# 5. External Speech-to-Text & AI Services (Boundary configuration)
# Leave blank to use built-in heuristic/transcription fallback
SPEECH_TO_TEXT_PROVIDER=""
SPEECH_TO_TEXT_API_KEY=""

# 6. Notification & SMS / Webhook Gateway (Boundary configuration)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
DISPATCH_WEBHOOK_URL=""

# 7. Simulation Geospatial Grid Center (Default: Tirupati Emergency Grid)
SIMULATED_CITY_NAME="Tirupati Emergency Grid"
CENTER_LAT=13.6288
CENTER_LNG=79.4192
